{
  "id": "anxiety-soft-landing",
  "voiceId": "de-katja",
  "edgeVoice": "de-DE-KatjaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 161,
  "chunks": [
    {
      "index": 0,
      "text": "Wenn Sie sich aktiviert oder besorgt fühlen, sind Sie hier willkommen.",
      "file": "c000.ogg",
      "durationSec": 8.424
    },
    {
      "index": 1,
      "text": "Sie müssen sich noch nicht ruhig fühlen.",
      "file": "c001.ogg",
      "durationSec": 5.232
    },
    {
      "index": 2,
      "text": "Folgen Sie einfach mit.",
      "file": "c002.ogg",
      "durationSec": 3.936
    },
    {
      "index": 3,
      "text": "Wenn möglich, stellen Sie beide Füße auf den Boden.",
      "file": "c003.ogg",
      "durationSec": 7.176
    },
    {
      "index": 4,
      "text": "Spüre den Kontakt. Absätze. Fußballen. Zehen.",
      "file": "c004.ogg",
      "durationSec": 11.952
    },
    {
      "index": 5,
      "text": "Leicht andrücken. Beachten Sie den Rückstoß vom Boden.",
      "file": "c005.ogg",
      "durationSec": 8.592
    },
    {
      "index": 6,
      "text": "Nennen Sie fünf Dinge, die Sie sehen können.",
      "file": "c006.ogg",
      "durationSec": 6.264
    },
    {
      "index": 7,
      "text": "Ruhig. Keine Eile.",
      "file": "c007.ogg",
      "durationSec": 5.424
    },
    {
      "index": 8,
      "text": "Nennen Sie vier Dinge, die Sie anfassen können.",
      "file": "c008.ogg",
      "durationSec": 6.624
    },
    {
      "index": 9,
      "text": "Kleidung. Stuhl. Luft auf der Haut.",
      "file": "c009.ogg",
      "durationSec": 8.472
    },
    {
      "index": 10,
      "text": "Nennen Sie drei Geräusche, nah oder fern.",
      "file": "c010.ogg",
      "durationSec": 6.024
    },
    {
      "index": 11,
      "text": "Nennen Sie zwei Düfte oder nehmen Sie einfach die Luft wahr.",
      "file": "c011.ogg",
      "durationSec": 7.224
    },
    {
      "index": 12,
      "text": "Nennen Sie einen Geschmack oder das Gefühl im Mund.",
      "file": "c012.ogg",
      "durationSec": 6.48
    },
    {
      "index": 13,
      "text": "Sie sind hier. In diesem Körper. In diesem Raum.",
      "file": "c013.ogg",
      "durationSec": 10.008
    },
    {
      "index": 14,
      "text": "Atmen Sie nun viermal ein.",
      "file": "c014.ogg",
      "durationSec": 4.464
    },
    {
      "index": 15,
      "text": "Halten Sie es sanft für zwei Personen.",
      "file": "c015.ogg",
      "durationSec": 5.376
    },
    {
      "index": 16,
      "text": "Aus für sechs.",
      "file": "c016.ogg",
      "durationSec": 3.12
    },
    {
      "index": 17,
      "text": "Nochmals, wenn Sie möchten.",
      "file": "c017.ogg",
      "durationSec": 4.728
    },
    {
      "index": 18,
      "text": "Legen Sie eine Hand auf die Brust oder den Bauch.",
      "file": "c018.ogg",
      "durationSec": 6.048
    },
    {
      "index": 19,
      "text": "Spüren Sie die Bewegung unter Ihrer Hand.",
      "file": "c019.ogg",
      "durationSec": 5.952
    },
    {
      "index": 20,
      "text": "Die Angst kann immer noch vorhanden sein. Das ist erlaubt.",
      "file": "c020.ogg",
      "durationSec": 8.592
    },
    {
      "index": 21,
      "text": "Sie haben dem Nervensystem eine sanftere Landung ermöglicht.",
      "file": "c021.ogg",
      "durationSec": 7.704
    },
    {
      "index": 22,
      "text": "Atme noch einmal durch.",
      "file": "c022.ogg",
      "durationSec": 4.224
    },
    {
      "index": 23,
      "text": "Wenn Sie bereit sind, öffnen Sie Ihre Augen und setzen Sie Ihren Tag fort.",
      "file": "c023.ogg",
      "durationSec": 9.192
    }
  ]
}
