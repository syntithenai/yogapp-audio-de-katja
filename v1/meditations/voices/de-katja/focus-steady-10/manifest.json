      "file": "c023.ogg",
      "durationSec": 2.28
    },
    {
      "index": 24,
      "text": "[Pause:21]",
      "file": "c024.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 25,
      "text": "Vier.",
      "file": "c025.ogg",
      "durationSec": 2.28
    },
    {
      "index": 26,
      "text": "[Pause:21]",
      "file": "c026.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 27,
      "text": "Fünf.",
      "file": "c027.ogg",
      "durationSec": 2.4
    },
    {
      "index": 28,
      "text": "[Pause:21]",
      "file": "c028.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 29,
      "text": "Fahren Sie schweigend bis zehn fort und beginnen Sie dann bei eins.",
      "file": "c029.ogg",
      "durationSec": 7.968
    },
    {
      "index": 30,
      "text": "[Pause:90]",
      "file": "c030.ogg",
      "durationSec": 90.0,
      "silence": true
    },
    {
      "index": 31,
      "text": "Lassen Sie die Zählung los.",
