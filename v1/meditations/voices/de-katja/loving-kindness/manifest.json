      "text": "Erstens: Dir selbst gegenüber.",
      "file": "c003.ogg",
      "durationSec": 5.424
    },
    {
      "index": 4,
      "text": "Wiederholen Sie es leise nach mir oder hören Sie einfach zu.",
      "file": "c004.ogg",
      "durationSec": 7.392
    },
    {
      "index": 5,
      "text": "Möge ich in Sicherheit sein.",
      "file": "c005.ogg",
      "durationSec": 4.56
    },
    {
      "index": 6,
      "text": "Möge es mir gut gehen.",
      "file": "c006.ogg",
      "durationSec": 4.272
    },
    {
      "index": 7,
      "text": "Möge ich mich wohlfühlen.",
      "file": "c007.ogg",
      "durationSec": 4.272
    },
    {
      "index": 8,
      "text": "Sagen Sie sie noch einmal, langsam.",
