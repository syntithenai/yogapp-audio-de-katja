{
  "id": "kindness-hard-day-5",
  "voiceId": "de-katja",
  "edgeVoice": "de-DE-KatjaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 323,
  "chunks": [
    {
      "index": 0,
      "text": "Willkommen.",
      "file": "c000.ogg",
      "durationSec": 3.024
    },
    {
      "index": 1,
      "text": "Suchen Sie sich einen bequemen Sitz oder legen Sie sich hin, wenn sich das besser anfühlt.",
      "file": "c001.ogg",
      "durationSec": 10.56
    },
    {
      "index": 2,
      "text": "Lassen Sie die Hände ruhen.",
      "file": "c002.ogg",
      "durationSec": 4.272
    },
    {
      "index": 3,
      "text": "Machen Sie die Augen weicher oder schließen Sie sie.",
      "file": "c003.ogg",
      "durationSec": 6.12
    },
    {
      "index": 4,
      "text": "Atme langsam ein.",
      "file": "c004.ogg",
      "durationSec": 3.744
    },
    {
      "index": 5,
      "text": "Und ein längeres Ausatmen.",
      "file": "c005.ogg",
      "durationSec": 4.68
    },
    {
      "index": 6,
      "text": "Sie müssen nicht so tun, als wäre es einfach.",
      "file": "c006.ogg",
      "durationSec": 6.72
    },
    {
      "index": 7,
      "text": "Lassen Sie die Wahrheit der Müdigkeit zu.",
      "file": "c007.ogg",
      "durationSec": 5.376
    },
    {
      "index": 8,
      "text": "[Pause:31]",
      "file": "c008.ogg",
      "durationSec": 31.0,
      "silence": true
    },
    {
      "index": 9,
      "text": "Atme Achtsamkeit ein.",
      "file": "c009.ogg",
      "durationSec": 4.416
    },
    {
      "index": 10,
      "text": "Atme den Anspruch aus, dass es dir gut geht.",
      "file": "c010.ogg",
      "durationSec": 6.576
    },
    {
      "index": 11,
      "text": "[Pause:31]",
      "file": "c011.ogg",
      "durationSec": 31.0,
      "silence": true
    },
    {
      "index": 12,
      "text": "Möge ich heute Abend sanft zu mir selbst sein.",
      "file": "c012.ogg",
      "durationSec": 6.144
    },
    {
      "index": 13,
      "text": "Möge ich ruhen, so wie ich bin.",
      "file": "c013.ogg",
      "durationSec": 5.256
    },
    {
      "index": 14,
      "text": "[Pause:31]",
      "file": "c014.ogg",
      "durationSec": 31.0,
      "silence": true
    },
    {
      "index": 15,
      "text": "Möge morgen nur gefragt werden, was ich geben kann.",
      "file": "c015.ogg",
      "durationSec": 7.176
    },
    {
      "index": 16,
      "text": "[Pause:31]",
      "file": "c016.ogg",
      "durationSec": 31.0,
      "silence": true
    },
    {
      "index": 17,
      "text": "Spüren Sie, wie der Körper gestützt wird.",
      "file": "c017.ogg",
      "durationSec": 6.264
    },
    {
      "index": 18,
      "text": "In dieser Minute ist nichts mehr erforderlich.",
      "file": "c018.ogg",
      "durationSec": 6.12
    },
    {
      "index": 19,
      "text": "[Pause:45]",
      "file": "c019.ogg",
      "durationSec": 45.0,
      "silence": true
    },
    {
      "index": 20,
      "text": "Hand aufs Herz, wenn es hilft.",
      "file": "c020.ogg",
      "durationSec": 5.064
    },
    {
      "index": 21,
      "text": "Du hast es geschafft.",
      "file": "c021.ogg",
      "durationSec": 3.744
    },
    {
      "index": 22,
      "text": "[Pause:38]",
      "file": "c022.ogg",
      "durationSec": 38.0,
      "silence": true
    },
    {
      "index": 23,
      "text": "Atmen Sie noch einmal ruhig durch.",
      "file": "c023.ogg",
      "durationSec": 5.256
    },
    {
      "index": 24,
      "text": "Wackeln Sie mit den Fingern.",
      "file": "c024.ogg",
      "durationSec": 4.224
    },
    {
      "index": 25,
      "text": "Wenn Sie bereit sind, öffnen Sie die Augen.",
      "file": "c025.ogg",
      "durationSec": 6.216
    },
    {
      "index": 26,
      "text": "Tragen Sie ein wenig davon bei sich.",
      "file": "c026.ogg",
      "durationSec": 5.136
    }
  ]
}
