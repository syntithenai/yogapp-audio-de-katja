{
  "id": "soft-belly-5",
  "voiceId": "de-katja",
  "edgeVoice": "de-DE-KatjaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 344,
  "chunks": [
    {
      "index": 0,
      "text": "Willkommen.",
      "file": "c000.ogg",
      "durationSec": 3.024
    },
    {
      "index": 1,
      "text": "Suchen Sie sich einen bequemen Sitz oder legen Sie sich hin, wenn sich das besser anfühlt.",
      "file": "c001.ogg",
      "durationSec": 10.56
    },
    {
      "index": 2,
      "text": "Lassen Sie die Hände ruhen.",
      "file": "c002.ogg",
      "durationSec": 4.272
    },
    {
      "index": 3,
      "text": "Machen Sie die Augen weicher oder schließen Sie sie.",
      "file": "c003.ogg",
      "durationSec": 6.12
    },
    {
      "index": 4,
      "text": "Atme langsam ein.",
      "file": "c004.ogg",
      "durationSec": 3.744
    },
    {
      "index": 5,
      "text": "Und ein längeres Ausatmen.",
      "file": "c005.ogg",
      "durationSec": 4.68
    },
    {
      "index": 6,
      "text": "Wenn Sie möchten, legen Sie eine Hand auf den Unterbauch.",
      "file": "c006.ogg",
      "durationSec": 7.248
    },
    {
      "index": 7,
      "text": "Beachten Sie, ob der Bauch hält.",
      "file": "c007.ogg",
      "durationSec": 5.184
    },
    {
      "index": 8,
      "text": "[Pause:20]",
      "file": "c008.ogg",
      "durationSec": 20.0,
      "silence": true
    },
    {
      "index": 9,
      "text": "Lassen Sie beim nächsten Einatmen zu, dass sich der Bauch ausdehnt.",
      "file": "c009.ogg",
      "durationSec": 8.088
    },
    {
      "index": 10,
      "text": "Lassen Sie es beim Ausatmen fallen, ohne es zu drücken.",
      "file": "c010.ogg",
      "durationSec": 7.296
    },
    {
      "index": 11,
      "text": "[Pause:20]",
      "file": "c011.ogg",
      "durationSec": 20.0,
      "silence": true
    },
    {
      "index": 12,
      "text": "Wieder. Weicher Bauch drin.",
      "file": "c012.ogg",
      "durationSec": 5.808
    },
    {
      "index": 13,
      "text": "Weicher Bauch raus.",
      "file": "c013.ogg",
      "durationSec": 3.672
    },
    {
      "index": 14,
      "text": "[Pause:25]",
      "file": "c014.ogg",
      "durationSec": 25.0,
      "silence": true
    },
    {
      "index": 15,
      "text": "Wenn der Geist argumentiert, überlassen Sie dem Körper die Führung.",
      "file": "c015.ogg",
      "durationSec": 8.352
    },
    {
      "index": 16,
      "text": "Erweiterung. Freigeben.",
      "file": "c016.ogg",
      "durationSec": 5.808
    },
    {
      "index": 17,
      "text": "[Pause:29]",
      "file": "c017.ogg",
      "durationSec": 29.0,
      "silence": true
    },
    {
      "index": 18,
      "text": "Schultern fallen herunter.",
      "file": "c018.ogg",
      "durationSec": 4.392
    },
    {
      "index": 19,
      "text": "Kiefer weich.",
      "file": "c019.ogg",
      "durationSec": 3.048
    },
    {
      "index": 20,
      "text": "Bauch frei.",
      "file": "c020.ogg",
      "durationSec": 2.808
    },
    {
      "index": 21,
      "text": "[Pause:25]",
      "file": "c021.ogg",
      "durationSec": 25.0,
      "silence": true
    },
    {
      "index": 22,
      "text": "Bleiben Sie bei zehn ruhigen, sanften Atemzügen.",
      "file": "c022.ogg",
      "durationSec": 7.392
    },
    {
      "index": 23,
      "text": "[Pause:45]",
      "file": "c023.ogg",
      "durationSec": 45.0,
      "silence": true
    },
    {
      "index": 24,
      "text": "Beachten Sie jede Leichtigkeit, die sich eingestellt hat.",
      "file": "c024.ogg",
      "durationSec": 7.584
    },
    {
      "index": 25,
      "text": "[Pause:20]",
      "file": "c025.ogg",
      "durationSec": 20.0,
      "silence": true
    },
    {
      "index": 26,
      "text": "Ruhe hier.",
      "file": "c026.ogg",
      "durationSec": 3.0
    },
    {
      "index": 27,
      "text": "[Pause:27]",
      "file": "c027.ogg",
      "durationSec": 27.0,
      "silence": true
    },
    {
      "index": 28,
      "text": "Atmen Sie noch einmal ruhig durch.",
      "file": "c028.ogg",
      "durationSec": 5.256
    },
    {
      "index": 29,
      "text": "Wackeln Sie mit den Fingern.",
      "file": "c029.ogg",
      "durationSec": 4.224
    },
    {
      "index": 30,
      "text": "Wenn Sie bereit sind, öffnen Sie die Augen.",
      "file": "c030.ogg",
      "durationSec": 6.216
    },
    {
      "index": 31,
      "text": "Tragen Sie ein wenig davon bei sich.",
      "file": "c031.ogg",
      "durationSec": 5.136
    }
  ]
}
