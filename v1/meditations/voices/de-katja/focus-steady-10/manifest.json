  "chunks": [
    {
      "index": 0,
      "text": "Willkommen.",
      "file": "c000.ogg",
      "durationSec": 3.024
    },
    {
      "index": 1,
      "text": "Nehmen Sie sich Zeit zum Ankommen.",
      "file": "c001.ogg",
      "durationSec": 5.208
    },
    {
      "index": 2,
      "text": "Setzen oder legen Sie sich mit Unterstützung hin.",
      "file": "c002.ogg",
      "durationSec": 6.36
    },
    {
      "index": 3,
      "text": "Schließen Sie die Augen, wenn sich das sicher anfühlt.",
      "file": "c003.ogg",
      "durationSec": 6.912
    },
    {
      "index": 4,
      "text": "Spüren Sie den Kontakt mit dem Boden.",
      "file": "c004.ogg",
      "durationSec": 5.712
    },
    {
      "index": 5,
      "text": "Langsam einatmen.",
      "file": "c005.ogg",
      "durationSec": 3.912
    },
    {
      "index": 6,
      "text": "Längeres Ausatmen.",
      "file": "c006.ogg",
      "durationSec": 4.008
    },
    {
      "index": 7,
      "text": "[Pause:21]",
      "file": "c007.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 8,
      "text": "Wieder.",
      "file": "c008.ogg",
      "durationSec": 2.4
    },
    {
      "index": 9,
      "text": "[Pause:21]",
      "file": "c009.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 10,
      "text": "Lassen Sie die Schultern fallen.",
      "file": "c010.ogg",
      "durationSec": 4.536
    },
    {
      "index": 11,
      "text": "Lassen Sie den Bauch weich werden.",
      "file": "c011.ogg",
      "durationSec": 4.632
    },
    {
      "index": 12,
      "text": "[Pause:26]",
      "file": "c012.ogg",
      "durationSec": 26.0,
      "silence": true
    },
    {
      "index": 13,
      "text": "Wählen Sie als Punkt den Atem an den Nasenlöchern.",
      "file": "c013.ogg",
      "durationSec": 6.576
    },
    {
      "index": 14,
      "text": "Bleiben Sie beim Gefühl von Luft.",
      "file": "c014.ogg",
      "durationSec": 4.872
    },
    {
      "index": 15,
      "text": "[Pause:26]",
      "file": "c015.ogg",
      "durationSec": 26.0,
      "silence": true
    },
    {
      "index": 16,
      "text": "Zählen Sie jedes Ausatmen von eins bis zehn.",
      "file": "c016.ogg",
      "durationSec": 6.624
    },
    {
      "index": 17,
      "text": "Wenn Sie den Überblick verlieren, beginnen Sie noch einmal bei eins ohne Vorwürfe.",
      "file": "c017.ogg",
      "durationSec": 9.936
    },
    {
      "index": 18,
      "text": "[Pause:21]",
      "file": "c018.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 19,
