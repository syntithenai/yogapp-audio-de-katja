    {
      "index": 0,
      "text": "Sitzen Sie bequem. Machen Sie das Gesicht weicher.",
      "file": "c000.ogg",
      "durationSec": 8.04
    },
    {
      "index": 1,
      "text": "Legen Sie eine Hand auf das Herz, wenn das hilft.",
      "file": "c001.ogg",
      "durationSec": 6.6
    },
    {
