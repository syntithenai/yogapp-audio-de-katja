      "durationSec": 44.0,
      "silence": true
    },
    {
      "index": 40,
      "text": "Spüren Sie den Raum noch einmal.",
      "file": "c040.ogg",
      "durationSec": 4.848
    },
    {
      "index": 41,
      "text": "Wackeln Sie mit Fingern und Zehen.",
      "file": "c041.ogg",
      "durationSec": 5.16
    },
    {
