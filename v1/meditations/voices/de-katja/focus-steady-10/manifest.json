      "file": "c036.ogg",
      "durationSec": 32.0,
      "silence": true
    },
    {
      "index": 37,
      "text": "Beginnen Sie, den Atem zu vertiefen.",
      "file": "c037.ogg",
      "durationSec": 5.88
    },
    {
      "index": 38,
      "text": "Ruhe hier.",
      "file": "c038.ogg",
