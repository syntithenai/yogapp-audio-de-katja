      "durationSec": 4.272
    },
    {
      "index": 32,
      "text": "Ruhen Sie mit bloßer Aufmerksamkeit auf Ihrem Atem.",
      "file": "c032.ogg",
      "durationSec": 7.056
    },
    {
      "index": 33,
      "text": "[Pause:79]",
      "file": "c033.ogg",
      "durationSec": 79.0,
      "silence": true
    },
    {
      "index": 34,
      "text": "Klarheit ohne Härte.",
      "file": "c034.ogg",
      "durationSec": 3.912
    },
    {
      "index": 35,
      "text": "[Pause:42]",
